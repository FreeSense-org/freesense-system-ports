#!/bin/sh
# Materialize FreeSense pkg repositories from one signed channel document.

set -u

PHP="${PHP:-/usr/local/bin/php}"
OPENSSL="${OPENSSL:-/usr/bin/openssl}"
READ_GLOBAL="/usr/local/sbin/read_global_var"

read_global() {
	if [ -x "${PHP}" ] && [ -r "${READ_GLOBAL}" ]; then
		"${PHP}" -n "${READ_GLOBAL}" "${1}" "${2}" 2>/dev/null
	else
		echo "${2}"
	fi
}

PRODUCT="${PRODUCT:-$(read_global product_name FreeSense)}"
REPOS_DIR="${REPOS_DIR:-$(read_global pkg_repos_path "/usr/local/etc/${PRODUCT}/pkg/repos")}"
SHARE_DIR="${SHARE_DIR:-/usr/local/share/${PRODUCT}}"
ARCH="${ARCH:-$(uname -p)}"
MANIFEST_URL="${MANIFEST_URL:-https://pkg.freesense.org/v1/repos.manifest.json}"
MANIFEST_LOCAL="${MANIFEST_LOCAL:-${SHARE_DIR}/repos.manifest.json}"
CHANNEL_KEY="${CHANNEL_KEY:-${SHARE_DIR}/keys/channel/public.pem}"
FETCH_TIMEOUT="${FETCH_TIMEOUT:-15}"

usage() {
	cat <<EOF
Usage: $(basename "$0") [-N] [-l] [-f] [-h]
  -N   synchronize repository files (default)
  -l   use only the trusted manifest baked into the image
  -f   print supported feature flags
  -h   show this help
EOF
}

NOFETCH=""
while getopts "Nlfh" option 2>/dev/null; do
	case "${option}" in
	N) : ;;
	l) NOFETCH=1 ;;
	f) echo "repodir-new-fstyle"; echo "osversion"; exit 0 ;;
	h) usage; exit 0 ;;
	*) usage >&2; exit 2 ;;
	esac
done

[ -x "${PHP}" ] || { echo "FreeSense-repoc: PHP is required" >&2; exit 1; }
WORK="$(mktemp -d -t freesense-repoc 2>/dev/null || echo "/tmp/freesense-repoc.$$")"
mkdir -p "${WORK}"
trap 'rm -rf "${WORK}"' EXIT HUP INT TERM

PAYLOAD=""
if [ -z "${NOFETCH}" ] && command -v curl >/dev/null 2>&1 && [ -r "${CHANNEL_KEY}" ]; then
	if curl -fsS --proto '=https' --max-time "${FETCH_TIMEOUT}" \
	    -o "${WORK}/envelope.json" "${MANIFEST_URL}" 2>/dev/null &&
	    "${PHP}" -n -r '
$doc = json_decode(file_get_contents($argv[1]), true);
if (!is_array($doc) || ($doc["schema_version"] ?? "") !== "freesense.repositories/v3") exit(2);
$payload = base64_decode($doc["payload"] ?? "", true);
$signature = base64_decode($doc["signature"] ?? "", true);
if ($payload === false || $signature === false || $payload === "" || $signature === "") exit(3);
file_put_contents($argv[2], $payload);
file_put_contents($argv[3], $signature);
' "${WORK}/envelope.json" "${WORK}/payload.json" "${WORK}/signature.bin" &&
	    "${OPENSSL}" dgst -sha256 -verify "${CHANNEL_KEY}" \
	      -signature "${WORK}/signature.bin" "${WORK}/payload.json" >/dev/null 2>&1; then
		PAYLOAD="${WORK}/payload.json"
	else
		echo "FreeSense-repoc: live channel document was unavailable or invalid; using baked channel" >&2
	fi
fi

if [ -z "${PAYLOAD}" ] && [ -r "${MANIFEST_LOCAL}" ]; then
	PAYLOAD="${MANIFEST_LOCAL}"
fi
[ -n "${PAYLOAD}" ] || { echo "FreeSense-repoc: no trusted channel document is available" >&2; exit 1; }

"${PHP}" -n -r '
$doc = json_decode(file_get_contents($argv[1]), true);
if (!is_array($doc) || ($doc["schema_version"] ?? "") !== "freesense.channels/v1" || !is_array($doc["channels"] ?? null)) exit(2);
foreach ($doc["channels"] as $key => $channel) {
    if (!is_array($channel)) exit(3);
    $name = (string)($channel["name"] ?? $key);
    $description = (string)($channel["description"] ?? $name);
    $train = (string)($channel["package_train"] ?? "");
    $abi = (string)($channel["abi"] ?? "");
    $altabi = (string)($channel["altabi"] ?? "");
    $system = is_array($channel["system"] ?? null) ? (string)($channel["system"]["url"] ?? "") : "";
    $packages = is_array($channel["packages"] ?? null) ? (string)($channel["packages"]["url"] ?? "") : "";
    if (!preg_match("/^[a-z0-9][a-z0-9.-]*$/", $name) || $train === "" || $abi === "" || $altabi === "") exit(4);
    if ($system === "" || !preg_match("#^https://pkg[.]freesense[.]org/v1/artifacts/system/[0-9a-f]{64}/amd64$#", $system)) exit(5);
    if ($packages !== "" && !preg_match("#^https://pkg[.]freesense[.]org/v1/artifacts/packages/[0-9]+[.][0-9]+/[0-9a-f]{64}/amd64$#", $packages)) exit(6);
    $fields = [$name, $description, $system, $packages, $train, $abi, $altabi, !empty($channel["default"]) ? "yes" : "no"];
    foreach ($fields as &$value) $value = str_replace(["|", "\r", "\n"], "", (string)$value);
    echo implode("|", $fields), "\n";
}
' "${PAYLOAD}" >"${WORK}/rows" || {
	echo "FreeSense-repoc: trusted channel payload is invalid" >&2
	exit 1
}

SELECTED=""
for marker in "${REPOS_DIR}/${PRODUCT}-repo-"*.default; do
	[ -e "${marker}" ] || continue
	SELECTED="${marker##*/${PRODUCT}-repo-}"
	SELECTED="${SELECTED%.default}"
	break
done
mkdir -p "${REPOS_DIR}"
rm -f "${REPOS_DIR}/${PRODUCT}-repo-"*.conf \
	"${REPOS_DIR}/${PRODUCT}-repo-"*.name \
	"${REPOS_DIR}/${PRODUCT}-repo-"*.descr \
	"${REPOS_DIR}/${PRODUCT}-repo-"*.abi \
	"${REPOS_DIR}/${PRODUCT}-repo-"*.altabi \
	"${REPOS_DIR}/${PRODUCT}-repo-"*.default 2>/dev/null || true

COUNT=0
DEFAULT_NAME=""
while IFS='|' read -r name description system_url packages_url train abi altabi default; do
	[ -n "${name}" ] || continue
	base="${REPOS_DIR}/${PRODUCT}-repo-${name}"
	cat >"${base}.conf" <<EOF
FreeBSD: { enabled: no }
FreeBSD-kmods: { enabled: no }

${PRODUCT}: {
  url: "${system_url}",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/share/${PRODUCT}/keys/system",
  priority: 100,
  enabled: yes
}
EOF
	if [ -n "${packages_url}" ]; then
		cat >>"${base}.conf" <<EOF

${PRODUCT}-packages: {
  url: "${packages_url}",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/share/${PRODUCT}/keys/packages",
  priority: 50,
  enabled: yes
}
EOF
	fi
	printf '%s' "${name}" >"${base}.name"
	printf '%s\n' "${description}" >"${base}.descr"
	printf '%s\n' "${abi}" >"${base}.abi"
	printf '%s\n' "${altabi}" >"${base}.altabi"
	[ "${default}" = yes ] && DEFAULT_NAME="${name}"
	COUNT=$((COUNT + 1))
done <"${WORK}/rows"

[ "${COUNT}" -gt 0 ] || { echo "FreeSense-repoc: channel document has no usable repositories" >&2; exit 1; }
if [ -n "${SELECTED}" ] && [ -f "${REPOS_DIR}/${PRODUCT}-repo-${SELECTED}.conf" ]; then
	: >"${REPOS_DIR}/${PRODUCT}-repo-${SELECTED}.default"
elif [ -n "${DEFAULT_NAME}" ]; then
	: >"${REPOS_DIR}/${PRODUCT}-repo-${DEFAULT_NAME}.default"
fi
