#!/bin/sh
# Materialize FreeSense pkg repositories from one signed channel document.

set -eu

PHP="${PHP:-/usr/local/bin/php}"
OPENSSL="${OPENSSL:-/usr/bin/openssl}"
READ_GLOBAL="/usr/local/sbin/read_global_var"

read_global() {
	if [ -x "${PHP}" ] && [ -r "${READ_GLOBAL}" ]; then
		"${PHP}" -n "${READ_GLOBAL}" "${1}" "${2}" 2>/dev/null
	else
		echo "${2}"
	fi
}

PRODUCT="${PRODUCT:-$(read_global product_name FreeSense)}"
REPOS_DIR="${REPOS_DIR:-$(read_global pkg_repos_path "/usr/local/etc/${PRODUCT}/pkg/repos")}"
SHARE_DIR="${SHARE_DIR:-/usr/local/share/${PRODUCT}}"
MANIFEST_URL="${MANIFEST_URL:-https://pkg.freesense.org/v1/repos.manifest.json}"
MANIFEST_LOCAL="${MANIFEST_LOCAL:-${SHARE_DIR}/repos.manifest.json}"
MANIFEST_CACHE="${MANIFEST_CACHE:-/cf/conf/${PRODUCT}-repos.manifest.json}"
CHANNEL_KEY="${CHANNEL_KEY:-${SHARE_DIR}/keys/channel/public.pem}"
FETCH_TIMEOUT="${FETCH_TIMEOUT:-15}"
LOCK_FILE="${LOCK_FILE:-/var/run/${PRODUCT}-repoc.lock}"
INSTALLED_VERSION_FILE="${INSTALLED_VERSION_FILE:-/etc/version}"
INSTALLED_VERSION="${INSTALLED_VERSION:-}"
if [ -z "${INSTALLED_VERSION}" ] && [ -r "${INSTALLED_VERSION_FILE}" ]; then
	IFS= read -r INSTALLED_VERSION <"${INSTALLED_VERSION_FILE}" || true
fi
[ -n "${INSTALLED_VERSION}" ] || INSTALLED_VERSION="0.0.0"

usage() {
	cat <<EOF
Usage: $(basename "$0") [-N] [-l] [-f] [-h]
  -N   synchronize repository files (default)
  -l   use only the read-only channel payload baked into the image
  -f   print supported feature flags
  -h   show this help
EOF
}

NOFETCH=""
while getopts "Nlfh" option 2>/dev/null; do
	case "${option}" in
	N) : ;;
	l) NOFETCH=1 ;;
	f) echo "repodir-new-fstyle"; echo "osversion"; exit 0 ;;
	h) usage; exit 0 ;;
	*) usage >&2; exit 2 ;;
	esac
done

[ -x "${PHP}" ] || { echo "FreeSense-repoc: PHP is required" >&2; exit 1; }
if [ -z "${NOFETCH}" ] && [ "${FREESENSE_REPOC_LOCKED:-}" != 1 ]; then
	lock_dir="$(dirname "${LOCK_FILE}")"
	mkdir -p "${lock_dir}"
	FREESENSE_REPOC_LOCKED=1
	export FREESENSE_REPOC_LOCKED
	if command -v lockf >/dev/null 2>&1; then
		exec lockf "${LOCK_FILE}" /bin/sh "$0" "$@"
	elif command -v flock >/dev/null 2>&1; then
		exec flock "${LOCK_FILE}" /bin/sh "$0" "$@"
	else
		echo "FreeSense-repoc: lockf or flock is required" >&2
		exit 1
	fi
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/freesense-repoc.XXXXXX")"
STAGED_REPOS=""
BACKUP_REPOS=""
cleanup() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ -n "${BACKUP_REPOS}" ] && [ -e "${BACKUP_REPOS}" ]; then
		if [ ! -e "${REPOS_DIR}" ]; then
			if mv "${BACKUP_REPOS}" "${REPOS_DIR}"; then
				BACKUP_REPOS=""
			else
				echo "FreeSense-repoc: repository recovery failed; backup remains at ${BACKUP_REPOS}" >&2
				status=1
			fi
		else
			rm -rf "${BACKUP_REPOS}"
			BACKUP_REPOS=""
		fi
	fi
	if [ -n "${STAGED_REPOS}" ] && [ -e "${STAGED_REPOS}" ]; then
		rm -rf "${STAGED_REPOS}"
	fi
	rm -rf "${WORK}"
	exit "${status}"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

SELECTED=""
for marker in "${REPOS_DIR}/${PRODUCT}-repo-"*.default; do
	[ -e "${marker}" ] || continue
	SELECTED="${marker##*/${PRODUCT}-repo-}"
	SELECTED="${SELECTED%.default}"
	break
done

validate_payload() {
	"${PHP}" -n -r '
function invalid_payload($code) {
    exit($code);
}
function safe_text($value) {
    return is_string($value) && $value !== "" &&
        !preg_match("/[|\\r\\n\\x00]/", $value);
}
function validate_component($component, $kind, $train, $schema) {
    if ($component === null) return null;
    if (!is_array($component)) invalid_payload(10);
    $fingerprint = $component["fingerprint"] ?? null;
    if (!is_string($fingerprint) ||
        !preg_match("/^[0-9a-f]{64}$/D", $fingerprint)) invalid_payload(11);
    if (!is_bool($component["verified"] ?? null)) invalid_payload(12);
    $generation = $component["generation"] ?? null;
    if (!is_int($generation) || $generation <= 0) invalid_payload(13);
    $expected = "https://pkg.freesense.org/v1/artifacts/system/" .
        $fingerprint . "/amd64";
    if ($kind === "system") {
        if (array_key_exists("system_fingerprint", $component) &&
            $component["system_fingerprint"] !== "") invalid_payload(15);
    } else {
        $expected = "https://pkg.freesense.org/v1/artifacts/packages/" .
            $train . "/" . $fingerprint . "/amd64";
    }
    if (in_array($schema, ["freesense.channels/v2", "freesense.channels/v3"], true)) {
        $pin = $component["freebsd_pin_id"] ?? null;
        if (!is_string($pin) || !preg_match("/^[0-9a-f]{64}$/D", $pin)) invalid_payload(17);
        if ($kind === "packages") {
            $built = $component["built_against_system"] ?? null;
            if (!is_string($built) || !preg_match("/^[0-9a-f]{64}$/D", $built)) invalid_payload(18);
        }
    }
    if (($component["url"] ?? null) !== $expected) invalid_payload(16);
    return $component;
}
function version_parts($value) {
    if (!is_string($value) || !preg_match("/^([0-9]+)[.]([0-9]+)[.]([0-9]+)$/D", $value, $parts)) {
        invalid_payload(29);
    }
    return [(int)$parts[1], (int)$parts[2], (int)$parts[3]];
}
function channel_is_eligible($version, $installed) {
    [$major, $minor, $patch] = version_parts($version);
    [$installed_major, $installed_minor, $installed_patch] = version_parts($installed);
    return [$major, $minor, $patch] >= [$installed_major, $installed_minor, $installed_patch];
}
function validate_document($filename, $installed) {
    $raw = @file_get_contents($filename);
    if ($raw === false || $raw === "") invalid_payload(20);
    $doc = json_decode($raw, true);
    $schema = $doc["schema_version"] ?? null;
    if (!is_array($doc) || json_last_error() !== JSON_ERROR_NONE ||
        !in_array($schema, ["freesense.channels/v1", "freesense.channels/v2", "freesense.channels/v3"], true) ||
        !is_array($doc["channels"] ?? null) || count($doc["channels"]) === 0) {
        invalid_payload(21);
    }
    $rows = [];
    $complete = [];
    $eligible = [];
    $defaults = 0;
    $default_name = "";
    foreach ($doc["channels"] as $key => $channel) {
        if (!is_string($key) ||
            !preg_match("/^[a-z0-9][a-z0-9.-]*$/D", $key) ||
            !is_array($channel) || ($channel["name"] ?? null) !== $key) {
            invalid_payload(22);
        }
        $description = $channel["description"] ?? null;
        $version = $channel["version"] ?? null;
        $train = $channel["package_train"] ?? null;
        $abi = $channel["abi"] ?? null;
        $altabi = $channel["altabi"] ?? null;
        $default = $channel["default"] ?? null;
        if (!safe_text($description) || !is_string($train) ||
            !preg_match("/^[0-9]+[.][0-9]+$/D", $train) ||
            !is_bool($default)) invalid_payload(23);
        if ($schema === "freesense.channels/v3") {
            [$version_major, $version_minor, $_version_patch] = version_parts($version);
            if ($train !== $version_major . "." . $version_minor) invalid_payload(29);
        } else {
            $version = $train . ".0";
        }
        if (!is_string($abi) || !is_string($altabi) ||
            !preg_match("/^FreeBSD:([0-9]+):amd64$/D", $abi, $abi_parts) ||
            !preg_match("/^freebsd:([0-9]+):x86:64$/D", $altabi, $altabi_parts) ||
            $abi_parts[1] !== $altabi_parts[1]) invalid_payload(24);
        $system = validate_component($channel["system"] ?? null, "system", $train, $schema);
        $packages = validate_component($channel["packages"] ?? null, "packages", $train, $schema);
        if ($packages !== null && $system === null) invalid_payload(25);
        if ($packages !== null) {
            $binding = $packages["system_fingerprint"] ?? null;
            if (!is_string($binding) ||
                !preg_match("/^[0-9a-f]{64}$/D", $binding) ||
                $binding !== $system["fingerprint"]) invalid_payload(26);
            if (in_array($schema, ["freesense.channels/v2", "freesense.channels/v3"], true) &&
                $packages["freebsd_pin_id"] !== $system["freebsd_pin_id"]) invalid_payload(28);
        }
        if ($default) {
            $defaults++;
            $default_name = $key;
        }
        $complete[$key] = $system !== null && $packages !== null &&
            $system["verified"] === true && $packages["verified"] === true;
        $eligible[$key] = $schema !== "freesense.channels/v3" || channel_is_eligible($version, $installed);
        if ($complete[$key] && $eligible[$key]) {
            $rows[] = implode("|", [
                $key,
                $description,
                $version,
                $system["url"],
                $packages["url"],
                $train,
                $abi,
                $altabi,
                $default ? "yes" : "no",
            ]);
        }
    }
    if ($defaults !== 1) invalid_payload(27);
    return [$doc, $rows, $complete, $eligible, $default_name];
}
function reject_generation_rollback($new_channel, $old_channel, $new_schema) {
    foreach (["system", "packages"] as $kind) {
        $old = $old_channel[$kind];
        $new = $new_channel[$kind];
        if ($new["generation"] < $old["generation"]) invalid_payload(31);
        if ($new["generation"] === $old["generation"] &&
            $new["fingerprint"] !== $old["fingerprint"]) invalid_payload(32);
        $binding_changed = $new_schema === "freesense.channels/v1" &&
            ($new["system_fingerprint"] ?? "") !== ($old["system_fingerprint"] ?? "");
        $pin_changed = in_array($new_schema, ["freesense.channels/v2", "freesense.channels/v3"], true) && (
            ($new["freebsd_pin_id"] ?? "") !== ($old["freebsd_pin_id"] ?? "") ||
            ($new["built_against_system"] ?? "") !== ($old["built_against_system"] ?? "")
        );
        if ($new["fingerprint"] === $old["fingerprint"] && (
            $new["generation"] !== $old["generation"] ||
            $new["url"] !== $old["url"] ||
            $binding_changed || $pin_changed
        )) invalid_payload(34);
    }
    if ($new_channel["system"]["fingerprint"] ===
        $old_channel["system"]["fingerprint"] && (
            $new_channel["package_train"] !== $old_channel["package_train"] ||
            $new_channel["abi"] !== $old_channel["abi"] ||
            $new_channel["altabi"] !== $old_channel["altabi"]
    )) invalid_payload(35);
}
[$candidate, $rows, $complete, $eligible, $default_name] = validate_document($argv[1], $argv[5]);
$selected = $argv[4] !== "" ? $argv[4] : $default_name;
if (($eligible[$selected] ?? true) === false) $selected = $default_name;
if (!isset($complete[$selected]) || !$complete[$selected] || !($eligible[$selected] ?? false)) invalid_payload(50);
if ($argv[3] !== "" && file_exists($argv[3])) {
    [$baseline, $_, $baseline_complete, $_baseline_eligible, $_default] = validate_document($argv[3], $argv[5]);
    if ($candidate["schema_version"] === "freesense.channels/v3" &&
        $baseline["schema_version"] === "freesense.channels/v3") {
        foreach ($candidate["channels"] as $name => $channel) {
            if (isset($baseline["channels"][$name]) &&
                version_compare($channel["version"], $baseline["channels"][$name]["version"], "<")) invalid_payload(36);
        }
    }
    if (($baseline_complete[$selected] ?? false) === true) {
        reject_generation_rollback(
            $candidate["channels"][$selected],
            $baseline["channels"][$selected],
            $candidate["schema_version"]
        );
    }
}
$encoded = implode("\n", $rows) . "\n";
if (@file_put_contents($argv[2], $encoded) !== strlen($encoded)) invalid_payload(40);
' "${1}" "${2}" "${3:-}" "${4:-}" "${INSTALLED_VERSION}"
}

persist_payload() {
	manifest_dir="$(dirname "${MANIFEST_CACHE}")"
	manifest_name="${MANIFEST_CACHE##*/}"
	mkdir -p "${manifest_dir}" || return 1
	manifest_tmp="$(umask 077; mktemp "${manifest_dir}/.${manifest_name}.tmp.XXXXXX")" || return 1
	if cp "${1}" "${manifest_tmp}" &&
	    chmod 0644 "${manifest_tmp}" &&
	    mv -f "${manifest_tmp}" "${MANIFEST_CACHE}"; then
		return 0
	fi
	rm -f "${manifest_tmp}" 2>/dev/null || true
	return 1
}

load_fallback() {
	if [ -e "${MANIFEST_CACHE}" ]; then
		if validate_payload "${MANIFEST_CACHE}" "${WORK}/rows" "" "${SELECTED}"; then
			return 0
		else
			fallback_status=$?
		fi
		if [ "${fallback_status}" -ne 50 ]; then
			echo "FreeSense-repoc: retained channel payload is invalid; refusing changes" >&2
			return 2
		fi
		echo "FreeSense-repoc: selected retained channel is still pending; trying baked channel" >&2
	fi
	if [ -r "${MANIFEST_LOCAL}" ]; then
		if validate_payload "${MANIFEST_LOCAL}" "${WORK}/rows" "" "${SELECTED}"; then
			return 0
		else
			fallback_status=$?
		fi
		if [ "${fallback_status}" -eq 50 ]; then
			echo "FreeSense-repoc: selected baked channel is still pending" >&2
		else
			echo "FreeSense-repoc: baked channel payload is invalid; refusing changes" >&2
		fi
		return 2
	fi
	return 1
}

LIVE_PAYLOAD=""
if [ -z "${NOFETCH}" ] && command -v curl >/dev/null 2>&1 && [ -r "${CHANNEL_KEY}" ]; then
	if curl -fsS --proto '=https' --max-time "${FETCH_TIMEOUT}" \
	    -o "${WORK}/envelope.json" "${MANIFEST_URL}" 2>/dev/null &&
	    "${PHP}" -n -r '
$doc = json_decode(file_get_contents($argv[1]), true);
if (!is_array($doc) || ($doc["schema_version"] ?? "") !== "freesense.repositories/v3") exit(2);
$payload = base64_decode($doc["payload"] ?? "", true);
$signature = base64_decode($doc["signature"] ?? "", true);
if ($payload === false || $signature === false || $payload === "" || $signature === "") exit(3);
if (@file_put_contents($argv[2], $payload) !== strlen($payload)) exit(4);
if (@file_put_contents($argv[3], $signature) !== strlen($signature)) exit(5);
' "${WORK}/envelope.json" "${WORK}/payload.json" "${WORK}/signature.bin" &&
	    "${OPENSSL}" dgst -sha256 -verify "${CHANNEL_KEY}" \
	      -signature "${WORK}/signature.bin" "${WORK}/payload.json" >/dev/null 2>&1; then
		LIVE_PAYLOAD="${WORK}/payload.json"
	else
		echo "FreeSense-repoc: live channel transport, envelope, or signature failed; trying trusted fallback" >&2
	fi
fi

if [ -n "${NOFETCH}" ]; then
	[ -r "${MANIFEST_LOCAL}" ] || {
		echo "FreeSense-repoc: no readable baked channel payload is available" >&2
		exit 1
	}
	validate_payload "${MANIFEST_LOCAL}" "${WORK}/rows" "" "${SELECTED}" || {
		echo "FreeSense-repoc: baked channel payload is pending or invalid; refusing changes" >&2
		exit 1
	}
elif [ -n "${LIVE_PAYLOAD}" ]; then
	if validate_payload "${LIVE_PAYLOAD}" "${WORK}/rows" "${MANIFEST_CACHE}" "${SELECTED}"; then
		persist_payload "${LIVE_PAYLOAD}" || {
			echo "FreeSense-repoc: could not atomically retain the validated live channel" >&2
			exit 1
		}
	else
		live_status=$?
		if [ "${live_status}" -ne 50 ]; then
			echo "FreeSense-repoc: signed live channel is invalid or rolled back; refusing changes" >&2
			exit 1
		fi
		echo "FreeSense-repoc: selected live channel is still pending; using trusted fallback" >&2
		if load_fallback; then
			:
		else
			echo "FreeSense-repoc: no complete trusted fallback channel is available" >&2
			exit 1
		fi
	fi
else
	if load_fallback; then
		:
	else
		echo "FreeSense-repoc: no complete trusted fallback channel is available" >&2
		exit 1
	fi
fi

repos_parent="$(dirname "${REPOS_DIR}")"
repos_name="${REPOS_DIR##*/}"
mkdir -p "${repos_parent}"
STAGED_REPOS="$(mktemp -d "${repos_parent}/.${repos_name}.new.XXXXXX")"

COUNT=0
DEFAULT_NAME=""
while IFS='|' read -r name description version system_url packages_url train abi altabi default; do
	[ -n "${name}" ] || continue
	base="${STAGED_REPOS}/${PRODUCT}-repo-${name}"
	cat >"${base}.conf" <<EOF
FreeBSD: { enabled: no }
FreeBSD-kmods: { enabled: no }

${PRODUCT}: {
  url: "${system_url}",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/share/${PRODUCT}/keys/system",
  priority: 100,
  enabled: yes
}

${PRODUCT}-packages: {
  url: "${packages_url}",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/share/${PRODUCT}/keys/packages",
  priority: 50,
  enabled: yes
}
EOF
	printf '%s' "${name}" >"${base}.name"
	printf '%s\n' "${description}" >"${base}.descr"
	printf '%s\n' "${version}" >"${base}.version"
	printf '%s\n' "${abi}" >"${base}.abi"
	printf '%s\n' "${altabi}" >"${base}.altabi"
	if [ "${default}" = yes ]; then
		DEFAULT_NAME="${name}"
	fi
	COUNT=$((COUNT + 1))
done <"${WORK}/rows"

[ "${COUNT}" -gt 0 ] || { echo "FreeSense-repoc: channel document has no usable repositories" >&2; exit 1; }
if [ -n "${SELECTED}" ] && [ -f "${STAGED_REPOS}/${PRODUCT}-repo-${SELECTED}.conf" ]; then
	: >"${STAGED_REPOS}/${PRODUCT}-repo-${SELECTED}.default"
elif [ -n "${DEFAULT_NAME}" ]; then
	: >"${STAGED_REPOS}/${PRODUCT}-repo-${DEFAULT_NAME}.default"
fi

if [ -e "${REPOS_DIR}" ]; then
	BACKUP_REPOS="$(mktemp -d "${repos_parent}/.${repos_name}.old.XXXXXX")"
	rmdir "${BACKUP_REPOS}"
	mv "${REPOS_DIR}" "${BACKUP_REPOS}"
fi
if mv "${STAGED_REPOS}" "${REPOS_DIR}"; then
	STAGED_REPOS=""
else
	swap_status=$?
	if [ -n "${BACKUP_REPOS}" ] && [ -e "${BACKUP_REPOS}" ]; then
		if mv "${BACKUP_REPOS}" "${REPOS_DIR}"; then
			BACKUP_REPOS=""
		else
			echo "FreeSense-repoc: repository swap and recovery both failed; backup remains at ${BACKUP_REPOS}" >&2
		fi
	fi
	echo "FreeSense-repoc: repository swap failed; previous state was retained" >&2
	exit "${swap_status}"
fi
if [ -n "${BACKUP_REPOS}" ] && [ -e "${BACKUP_REPOS}" ]; then
	rm -rf "${BACKUP_REPOS}"
	BACKUP_REPOS=""
fi
